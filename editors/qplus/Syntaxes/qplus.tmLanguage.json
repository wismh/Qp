{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Q+",
  "scopeName": "source.qplus",
  "fileTypes": ["qp"],
  "uuid": "a7e4c8d1-9b2f-4e5a-8c3d-6f1a0b9e2d47",
  "patterns": [
    { "include": "#comments" },
    { "include": "#strings" },
    { "include": "#chars" },
    { "include": "#numbers" },
    { "include": "#attributes" },
    { "include": "#keywords" },
    { "include": "#paths" },
    { "include": "#types" },
    { "include": "#constants" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.qplus",
          "match": "//.*$"
        },
        {
          "name": "comment.block.qplus",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.raw.qplus",
          "begin": "#\"",
          "end": "\"#"
        },
        {
          "name": "string.quoted.double.qplus",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.qplus",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.qplus",
              "begin": "\\$\\{",
              "end": "\\}",
              "beginCaptures": {
                "0": { "name": "punctuation.section.interpolation.begin.qplus" }
              },
              "endCaptures": {
                "0": { "name": "punctuation.section.interpolation.end.qplus" }
              },
              "patterns": [{ "include": "$self" }]
            }
          ]
        }
      ]
    },
    "chars": {
      "name": "string.quoted.single.qplus",
      "match": "'(\\\\.|[^'\\\\])'"
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.integer.hex.qplus",
          "match": "\\b0x[0-9A-Fa-f_]+\\b"
        },
        {
          "name": "constant.numeric.float.qplus",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?(f32|f64)?\\b"
        },
        {
          "name": "constant.numeric.integer.qplus",
          "match": "\\b[0-9][0-9_]*(i8|i16|i32|i64|u8|u16|u32|u64)?\\b"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.fn.qplus" },
            "2": { "name": "entity.name.function.qplus" }
          }
        },
        {
          "match": "\\b(struct|enum|variant|trait)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "storage.type.qplus" },
            "2": { "name": "entity.name.type.qplus" }
          }
        },
        {
          "match": "\\b(impl)\\s+([A-Za-z_][A-Za-z0-9_]*)(?:\\s+(for)\\s+([A-Za-z_][A-Za-z0-9_]*))?",
          "captures": {
            "1": { "name": "storage.type.qplus" },
            "2": { "name": "entity.name.type.qplus" },
            "3": { "name": "keyword.other.qplus" },
            "4": { "name": "entity.name.type.qplus" }
          }
        },
        {
          "match": "\\b(mod)\\s+([A-Za-z_][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.other.qplus" },
            "2": { "name": "entity.name.namespace.qplus" }
          }
        },
        {
          "match": "\\b(from)\\s+([A-Za-z_][A-Za-z0-9_]*)\\s+(use)\\b",
          "captures": {
            "1": { "name": "keyword.control.import.qplus" },
            "2": { "name": "entity.name.namespace.qplus" },
            "3": { "name": "keyword.control.import.qplus" }
          }
        },
        {
          "match": "\\b(use)\\s+",
          "name": "keyword.control.import.qplus"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.qplus",
          "match": "\\b(async|break|continue|else|for|if|in|loop|match|return|while|where)\\b"
        },
        {
          "name": "storage.modifier.qplus",
          "match": "\\b(pub|mut|ref|dyn|const|extern)\\b"
        },
        {
          "name": "storage.type.qplus",
          "match": "\\b(fn|struct|enum|variant|trait|impl)\\b"
        },
        {
          "name": "keyword.other.qplus",
          "match": "\\b(as|from|let|mod|new|type|use)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.primitive.qplus",
          "match": "\\b(bool|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|char|string)\\b"
        },
        {
          "name": "entity.name.type.qplus",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.qplus",
          "match": "\\b(true|false|null)\\b"
        },
        {
          "name": "variable.language.qplus",
          "match": "\\bself\\b"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "support.function.builtin.qplus",
          "match": "\\b(sin|cos|tan|asin|acos|atan|atan2|sqrt|abs|floor|ceil|fmod|pow|exp|ln|log2|to_string|type_id|type_name|field_count|field_name|field_type_name|fn_name)\\b"
        },
        {
          "name": "entity.name.function.qplus",
          "match": "\\b([A-Za-z_][A-Za-z0-9_]*)\\s*(?=\\()"
        }
      ]
    },
    "paths": {
      "patterns": [
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Z][A-Za-z0-9_]*)\\s*(::)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.qplus" },
            "2": { "name": "punctuation.separator.namespace.qplus" },
            "3": { "name": "entity.name.type.enum.qplus" },
            "4": { "name": "punctuation.separator.namespace.qplus" },
            "5": { "name": "variable.other.enummember.qplus" }
          }
        },
        {
          "match": "\\b([A-Z][A-Za-z0-9_]*)\\s*(::)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.type.enum.qplus" },
            "2": { "name": "punctuation.separator.namespace.qplus" },
            "3": { "name": "variable.other.enummember.qplus" }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(::)\\s*([A-Z][A-Za-z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.namespace.qplus" },
            "2": { "name": "punctuation.separator.namespace.qplus" },
            "3": { "name": "entity.name.type.qplus" }
          }
        },
        {
          "match": "\\b([a-z_][A-Za-z0-9_]*)\\s*(::)",
          "captures": {
            "1": { "name": "entity.name.namespace.qplus" },
            "2": { "name": "punctuation.separator.namespace.qplus" }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.qplus",
          "match": "=>|->|\\.\\.\\.|\\.\\.|::|\\?\\?|\\?\\.|&&|\\|\\||==|!=|<=|>=|\\+=|-=|\\*=|/=|[+\\-*/%=<>!?:]"
        }
      ]
    }
  }
}
