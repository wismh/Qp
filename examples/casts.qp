pub fn widen(x: i32) -> i64 {
    x as i64
}

pub fn trunc(x: f32) -> i32 {
    x as i32
}

pub fn flag(b: bool) -> i32 {
    b as i32
}

pub enum Color {
    Red,
    Green = 2,
}

pub fn red_code() -> i32 {
    Color::Red as i32
}

pub fn run() -> i32 {
    (widen(1) as i32) + trunc(2.9) + flag(true) + red_code()
}
