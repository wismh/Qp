pub enum Color {
    Red,
    Green,
    Blue,
}

pub fn color_code(c: Color) -> i32 {
    match c {
        Red => 1,
        Green => 2,
        Blue => 3,
    }
}

pub fn sum2(xs: [i32]) -> i32 {
    xs[0] + xs[1]
}

pub fn second(buf: [i32; 2]) -> i32 {
    buf[1]
}

pub fn get_hp(stats: {string: i32}) -> i32 {
    stats["hp"]
}

pub fn sample_list() -> [i32] {
    [10, 20]
}

pub fn sample_map() -> {string: i32} {
    {"hp": 7}
}
