trait Area {
    fn area(self) -> i32;
}

struct Rect {
    w: i32,
    h: i32,
}

struct Square {
    side: i32,
}

impl Area for Rect {
    fn area(self) -> i32 {
        self.w * self.h
    }
}

impl Area for Square {
    fn area(self) -> i32 {
        self.side * self.side
    }
}

fn area_of(d: dyn Area) -> i32 {
    d.area()
}

pub fn run() -> i32 {
    area_of(Rect { w: 3, h: 4 }) + area_of(Square { side: 2 })
}
