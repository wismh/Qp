pub fn abs(x: i32) -> i32 {
    if x < 0 {
        return 0 - x;
    }
    x
}

pub fn sign(x: i32) -> i32 {
    if x < 0 {
        return 0 - 1;
    } else if x == 0 {
        return 0;
    } else {
        1
    }
}

pub fn clamp_or_zero(x: i32, lo: i32, hi: i32) -> i32 {
    if x < lo {
        return 0;
    }
    if x > hi {
        return 0;
    }
    x
}
