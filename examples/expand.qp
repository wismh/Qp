pub fn apply<...Cs>(f: fn(Cs...) -> i32, ...xs: Cs) -> i32 {
    f(xs...)
}

pub fn as_tuple<...Cs>(...xs: Cs) -> (Cs...) {
    xs...
}

pub fn add2(a: i32, b: i32) -> i32 {
    a + b
}

pub fn add1(a: i32) -> i32 {
    a + 1
}

pub fn run() -> i32 {
    let t = as_tuple<i32, i32>(3, 4);
    apply<i32, i32>(add2, 10, 7) + apply<i32>(add1, 5) + t.0 + t.1
}
