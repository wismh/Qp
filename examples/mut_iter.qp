pub fn bump(mut n: i32) {
    n = n + 1;
}

pub fn sum_bumped() -> i32 {
    let mut xs = [1, 2];
    for mut x in xs {
        x = x + 1;
    }
    let mut s = 0;
    for x in xs {
        s = s + x;
    }
    s
}

pub fn sum_pairs() -> i32 {
    let mut xs = [(1, 10), (2, 20)];
    for (mut a, mut b) in xs {
        a = a + 1;
        b = b + 1;
    }
    xs[0].0 + xs[0].1 + xs[1].0 + xs[1].1
}

pub fn run() -> i32 {
    let mut n = 10;
    bump(n);
    sum_bumped() + sum_pairs() + n
}
