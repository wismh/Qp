pub fn abs(x: i32) -> i32 {
    if x < 0 { -x } else { x }
}

pub fn abs(x: f32) -> f32 {
    if x < 0.0 { -x } else { x }
}

struct Counter {
    mut n: i32,
}

impl Counter {
    fn bump(mut self) {
        self.n = self.n + 1;
    }

    fn bump(mut self, by: i32) {
        self.n = self.n + by;
    }
}

pub fn run() -> i32 {
    let mut c = Counter { n: 0 };
    c.bump();
    c.bump(4);
    abs(-3) + c.n
}
