pub struct Vec2 {
    mut x: f32,
    mut y: f32,
}

impl Vec2 {
    pub fn add(self, other: Vec2) -> Vec2 {
        Vec2 { x: self.x + other.x, y: self.y + other.y }
    }

    pub fn scale(mut self, s: f32) {
        self.x = self.x * s;
        self.y = self.y * s;
    }

    pub fn length_sq(self) -> f32 {
        self.x * self.x + self.y * self.y
    }
}

pub fn add_x(a: Vec2, b: Vec2) -> f32 {
    a.add(b).x
}
